{
  "uid": "sightline-logs",
  "title": "Sightline \u2014 logs",
  "description": "What the processes said, over the structured pino output promtail is already collecting.",
  "tags": ["sightline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Log volume by component",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (app) (rate({namespace=\"sightline\"}[5m]))",
          "queryType": "range",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Already collected: promtail tails every pod on the node, so these arrived without anything being configured for Sightline."
    },
    {
      "id": 2,
      "title": "Errors per minute",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (app) (rate({namespace=\"sightline\"} | json | level >= 50 [5m])) * 60",
          "queryType": "range",
          "legendFormat": "{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "pino's numeric levels: 50 is error, 60 is fatal. Parsed with | json because the logs are structured, so this is a field comparison rather than a string match."
    },
    {
      "id": 3,
      "title": "Most frequent errors (6h)",
      "type": "table",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "topk(10, sum by (msg) (count_over_time({namespace=\"sightline\"} | json | level >= 50 [6h])))",
          "queryType": "range",
          "legendFormat": "{{msg}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Grouped by message rather than listed, so one error repeating ten thousand times is one row instead of ten thousand lines."
    },
    {
      "id": 4,
      "title": "Does the redaction still hold?",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({namespace=\"sightline\"} |~ `sightline-[0-9a-f]{16}` [24h]))",
          "queryType": "range",
          "legendFormat": "external-id-shaped strings"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Must be zero, for ever. An ExternalId is half a credential for a customer's cloud and the logger redacts it by field name at every nesting depth - but redaction covers the fields it knows, and a value interpolated into a message string is not a field. This panel watches the guarantee rather than trusting it. Any non-zero result is an incident, not a bug.",
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "The scan worker, live",
      "type": "logs",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{namespace=\"sightline\"}, app=\"worker\"",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Where scans actually run. Correlate with the pipeline dashboard: a unit failing there has its reason here, with the correlation id.",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
