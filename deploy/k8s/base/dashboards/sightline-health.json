{
  "uid": "sightline-health",
  "title": "Sightline — is it healthy?",
  "description": "The four golden signals, then what the cluster says about the pods serving them.",
  "tags": ["sightline"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_requests_total{namespace=\"sightline\"}[5m]))",
          "legendFormat": "requests/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(rate(http_requests_total{namespace=\"sightline\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Traffic with errors on the same axis, so one against the other is visible without switching panels."
    },
    {
      "id": 2,
      "title": "Error ratio",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "(sum(rate(http_requests_total{namespace=\"sightline\", status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{namespace=\"sightline\"}[5m])), 0.001)",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit",
          "noValue": "0"
        },
        "overrides": []
      },
      "description": "clamp_min keeps an idle deployment from dividing by zero and reading NaN rather than nothing."
    },
    {
      "id": 3,
      "title": "Latency",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"sightline\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"sightline\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"sightline\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "description": "Quantiles, not an average: a mean request time hides exactly the tail a person notices."
    },
    {
      "id": 4,
      "title": "Slowest routes (p95, 30m)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{namespace=\"sightline\"}[30m]))))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s"
        },
        "overrides": []
      },
      "description": "By route template. The scan stream is legitimately slow; anything else beside it is worth a look."
    },
    {
      "id": 5,
      "title": "Requests in flight",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum(http_requests_in_flight{namespace=\"sightline\"})",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Saturation rather than traffic: a number climbing while the rate is flat means requests are piling up."
    },
    {
      "id": 6,
      "title": "Scrape health",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "up{namespace=\"sightline\", app_kubernetes_io_name=\"api\"}",
          "legendFormat": "api {{pod}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "up{namespace=\"sightline\", app_kubernetes_io_name=\"worker\"}",
          "legendFormat": "worker {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "A worker that is down shows here before the queue backs up behind it. Selected by `app_kubernetes_io_name`, not `app`: Prometheus sanitises this project's `app.kubernetes.io/name` label into that, and there is no `app` label on these targets - a selector on `app` matches nothing and reads as an outage.",
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "title": "Container restarts (1h)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (container) (increase(kube_pod_container_status_restarts_total{namespace=\"sightline\"}[1h]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "From kube-state-metrics. A pod restarting with nothing in its own log is what an OOMKill looks like."
    },
    {
      "id": 8,
      "title": "Memory against limit",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"sightline\", container!=\"\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"sightline\", resource=\"memory\"})",
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "How close each pod is to being killed. The worker sits highest while a scan holds a whole inventory in memory."
    },
    {
      "id": 9,
      "title": "Build",
      "type": "table",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "expr": "sightline_build_info{namespace=\"sightline\"}",
          "legendFormat": "{{version}} {{commit}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "description": "Which build these graphs describe. Without it a graph cannot be attributed to a deploy.",
      "options": {
        "showHeader": true
      }
    }
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": ["sightline"],
      "asDropdown": false,
      "title": "Sightline",
      "includeVars": false,
      "keepTime": true
    }
  ]
}
