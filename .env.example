# Copy this file to .env and fill in real values where needed.
# `.env` is gitignored.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=sightline
POSTGRES_PASSWORD=sightline
POSTGRES_DB=sightline
POSTGRES_PORT=5432
DATABASE_URL=postgres://sightline:sightline@localhost:5432/sightline

# The restricted role every tenant-scoped query runs as.
#
# This is what makes row-level security real. DATABASE_URL above is the table
# owner, and in this compose file a superuser - and superusers ignore RLS
# entirely, FORCE ROW LEVEL SECURITY included, so policies installed against it
# filter nothing. With this set, a query that forgets its tenant filter returns
# no rows instead of somebody else's inventory.
#
# Optional for a clone: one tenant has nothing to leak to, and leaving it unset
# keeps the owner connection, which is today's behaviour. Hosted mode refuses to
# start without it.
#
# The migration creates the role with no password, so it cannot connect until
# you set one - pick a password, put it here, then run:
#
#   npm run db:app-role -w @sightline/api
#
# which sets the role's password to match this string and proves it can connect.
# DATABASE_URL_APP=postgres://sightline_app:choose-a-password@localhost:5432/sightline

# --- AWS (customer onboarding) -------------------------------------------
# Sightline's backend assumes a role per customer using a per-customer
# ExternalId. This is identical in mock and production; only AWS_ENDPOINT_URL
# and the source credentials differ.
#
# These two are used in whichever mode AWS_MODE names below. Pointing this file
# at a real account and then using the UI's Demo toggle falls back to the
# seeded mock's own role and external id, since the real ones would not apply.
AWS_TARGET_ROLE_ARN=arn:aws:iam::123456789012:role/SightlineReadOnlyRole
AWS_EXTERNAL_ID=local-dev-external-id-0000
AWS_REGION=us-east-1

# Who or what triggered a scan, sent as sts:SourceIdentity on every AssumeRole so
# the customer's own CloudTrail can attribute activity to an operator rather than
# only to the shared scanner role. Prefixed with "sightline-" and sanitised to the
# characters AWS permits, so anything here is safe to set.
SCAN_OPERATOR=system

# Regions to scan, comma-separated. Leave empty to discover every region
# enabled for the account via ec2:DescribeRegions - which is what you want on a
# real account, and slower. Unset entirely, the scanner defaults to the three
# regions the mock account uses.
AWS_SCAN_REGIONS=us-east-1,eu-west-1,ap-southeast-1

# Max concurrent (service, region) units in flight.
# SCAN_CONCURRENCY=6
#
# AWS requests a second per account, service and region, so a scan stays
# under the customer's own throttling limits rather than backing off after them.
# SCAN_AWS_REQUESTS_PER_SECOND=20

# Where scans run. `embedded` drains the queue inside the API process, which is
# what a single-operator deployment wants: one container, and `npm run dev:api`
# scans on its own. `separate` makes this process serve requests only, so a scan
# that exhausts memory takes down a worker rather than the API serving everybody
# else - run `npm run dev:worker` alongside it. `off` is for a process that must
# never scan. Defaults to `embedded`, or `separate` when DEPLOYMENT_MODE=hosted.
# SCAN_WORKER=embedded

# How many scans one worker runs at once. A scan holds a whole inventory in
# memory while it is analysed, so this multiplies the worker's peak memory -
# raise it only with the machine in mind.
# SCAN_WORKER_CONCURRENCY=1

# --- Limits ---------------------------------------------------------------
# Every one of these bounds something that costs real money: a scan spends AWS
# API calls and worker memory, a question spends Anthropic tokens. The two with
# no value shown default differently by deployment mode, because in a clone the
# money being spent is the operator's own and rationing their single user
# protects nobody.
#
# Kill switches. Accepts 1/true/yes/on and 0/false/no/off, and refuses anything
# else at startup rather than guessing - a switch that silently stays on is
# worse than none. Changing either needs a restart.
# SCANS_ENABLED=true
# CHAT_ENABLED=true
#
# Minimum gap between finishing one scan of an account and starting the next,
# measured from the finish so a slow scan does not eat its own cooldown.
# Defaults to 0 self-hosted, 300 hosted.
# SCAN_COOLDOWN_SECONDS=
#
# Scans one tenant may have queued or running across all their accounts. The
# per-account limit of one is a database index and is not configurable.
# MAX_ACTIVE_SCANS_PER_TENANT=3
#
# Resources one scan may produce before it is recorded but not projected. Bounds
# the graph rather than the scan's own peak memory - the collectors have already
# held everything by the time this is checked.
# MAX_RESOURCES_PER_SCAN=150000
#
# Finished scans kept per account. Each holds a full copy of the estate, so this
# bounds the database; older scans are deleted after every scan. Minimum 2.
# SCAN_HISTORY_KEEP=30
#
# Questions one tenant may ask the agent per hour. Without it, a public
# deployment's Anthropic key is a free Claude proxy for anyone who signs up.
# Unset means no limit, which is the self-hosted default; hosted defaults to 60.
# CHAT_QUESTIONS_PER_HOUR=
#
# Model tokens, input plus output, one tenant's answers may use in 24 hours -
# what a question actually costs, which a count of questions does not bound.
# Unset means no limit self-hosted; hosted defaults to 2,000,000.
# CHAT_TOKENS_PER_DAY=
#
# Requests a minute on every endpoint, per signed-in session or per address
# when signed out; sign-in routes get the second, lower number. Hosted only.
# RATE_LIMIT_PER_MINUTE=300
# RATE_LIMIT_AUTH_PER_MINUTE=20

# Testing hook: comma-separated service:region pairs that should fail, used to
# demonstrate partial-failure handling. Example: rds:eu-west-1,lambda:us-east-1
# SCAN_FAULT_INJECTION=

# --- Mock AWS -------------------------------------------------------------
# AWS_MODE=mock points the SDK at moto. AWS_MODE=real drops the endpoint
# override and uses the ambient credential chain against real AWS.
AWS_MODE=mock
MOCK_AWS_PORT=5000
MOCK_AWS_ACCOUNT_ID=123456789012
AWS_ENDPOINT_URL=http://localhost:5000
# Source credentials used to call sts:AssumeRole. Ignored when AWS_MODE=real,
# where the standard AWS credential chain is used instead.
AWS_ACCESS_KEY_ID=mock
AWS_SECRET_ACCESS_KEY=mock

# --- Deployment mode ------------------------------------------------------
# `self-hosted` (the default) is one operator, one tenant, no sign-in - what a
# clone of this repository runs, and what everything above describes.
#
# `hosted` is the public multi-tenant service. It REFUSES TO START unless the
# keys below it are set, and it refuses several of the settings above outright:
# AWS_ENDPOINT_URL (an SDK-wide override applies to calls made with credentials
# assumed inside a customer's account), AWS_MODE=mock (process-wide, so one
# tenant's view would decide every tenant's), and a placeholder access key
# (first in the SDK's credential chain, so it shadows the platform identity).
# `apps/api/src/hostedMode.ts` is the list, with the reason for each.
# DEPLOYMENT_MODE=self-hosted

# Where the service is reachable. Decides the OAuth redirect, and whether the
# session cookie is Secure - which follows the scheme rather than the mode, so
# testing the hosted path over http://<lan-ip> still signs you in instead of
# silently dropping the cookie.
# PUBLIC_BASE_URL=https://sightline.example

# Tenant secrets at rest. An external id is half a credential for a customer's
# cloud, so hosted mode requires KMS and refuses a key that lives in the
# environment beside the database it protects. Self-hosted may use a local key;
# any length works, it is hashed to 32 bytes.
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:...:key/...
# SECRETS_LOCAL_KEY=
# An identity allowed only kms:Encrypt/Decrypt on that key, for the API, so it
# never holds the scanner identity (AWS_ACCESS_KEY_ID) that only the worker needs.
# KMS_ACCESS_KEY_ID=
# KMS_SECRET_ACCESS_KEY=

# Or no access keys at all: IAM Roles Anywhere, with a certificate from a CA of
# your own (scripts/roles-anywhere-ca.sh, free). All five or none. When set they
# are this process's AWS identity, for AssumeRole and KMS alike - so give the
# worker the scanner role and the API a KMS-only one. deploy/k8s/README.md.
# ROLES_ANYWHERE_CERTIFICATE=roles-anywhere/worker.pem
# ROLES_ANYWHERE_PRIVATE_KEY=roles-anywhere/worker.key
# ROLES_ANYWHERE_TRUST_ANCHOR_ARN=arn:aws:rolesanywhere:us-east-1:...:trust-anchor/...
# ROLES_ANYWHERE_PROFILE_ARN=arn:aws:rolesanywhere:us-east-1:...:profile/...
# ROLES_ANYWHERE_ROLE_ARN=arn:aws:iam::...:role/SightlineScanner

# The demo fixture's endpoint, for tenants who choose the demo account.
# Deliberately NOT AWS_ENDPOINT_URL: this one applies only to demo connections
# and cannot be influenced by a tenant. Unset, no demo connection can exist.
# DEMO_AWS_ENDPOINT_URL=http://moto:5000

# This service's own identity - the principal every customer's trust policy
# names - and where the read-only role template is published, so the one-click
# CloudFormation link has something to point at.
# SCANNER_PRINCIPAL_ARN=arn:aws:iam::123456789012:user/SightlineScanner
# ROLE_TEMPLATE_URL=https://sightline-templates.s3.amazonaws.com/v1/readonly-role.yaml

# Sign-in. At least one provider, or nobody can get in at all.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_SECRET=
# SESSION_TTL_HOURS=8

# --- LLM (agent) ----------------------------------------------------------
# The agent uses Anthropic. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-5

# --- App ------------------------------------------------------------------
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Port the containerised app is published on, used only by the optional
# `app` profile: docker compose --profile app up -d, then open
# http://localhost:8080. Irrelevant to the local-development path above.
APP_PORT=8080

# Extra compose files, applied to every `docker compose` command automatically.
#
# Uncomment this if you run the containerised app against a REAL AWS account. It
# mounts your ~/.aws read-only into the API container, which the standard AWS
# credential chain needs and a container does not otherwise have.
#
# Set it here rather than passing `-f` flags, because the flags have to be on
# EVERY compose command: recreating the API to pick up an edited .env with a
# plain `docker compose --profile app up -d api` would otherwise drop the mount
# silently, and the next connection test reports "No source credentials were
# found" for a setup that was working a moment earlier (engineering log #45).
#
# Uncomment BOTH lines. Compose on Windows splits COMPOSE_FILE on ';', not ':',
# so without the separator line the path is read as one filename and fails.
#
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:deploy/compose.aws-profile.yml

# Where your AWS profile lives, for the mount above. Normally leave this unset:
# the mount uses ${HOME}/.aws, falling back to ${USERPROFILE}/.aws where HOME is
# not set (Windows PowerShell). Do not set a Windows path here if you also run
# Compose from WSL: the Linux docker CLI cannot read `C:/...` and fails with
# "invalid volume specification". WSL's own ~/.aws works there instead.
#
# AWS_PROFILE_DIR=C:/Users/you/.aws

# Bind addresses. Both default to loopback.
#
# To reach the UI from another machine (a tailnet, a LAN), set
# FRONTEND_HOST=0.0.0.0 and browse to http://<this-host-ip>:5173. Only the
# frontend needs exposing: it proxies /api server-side, so the backend stays
# on loopback and there is one open port rather than two.
# BACKEND_HOST=127.0.0.1
# FRONTEND_HOST=0.0.0.0
