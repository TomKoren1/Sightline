{
  "name": "daveio-assignment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "node scripts/deps.mjs && npm run typecheck --workspaces --if-present",
    "test": "node scripts/deps.mjs && vitest run",
    "test:watch": "node scripts/deps.mjs && vitest",
    "lint": "node scripts/deps.mjs && prettier --check .",
    "format": "node scripts/deps.mjs && prettier --write .",
    "seed": "node scripts/deps.mjs && npm run seed -w @daveio/mock-aws",
    "scan": "node scripts/deps.mjs && npm run scan -w @daveio/api",
    "dev:api": "node scripts/deps.mjs && npm run dev -w @daveio/api",
    "dev:web": "node scripts/deps.mjs && npm run dev -w @daveio/web",
    "evals": "node scripts/deps.mjs && npm run evals -w @daveio/api",
    "verify": "node scripts/deps.mjs && npm run typecheck && npm run lint && vitest run --exclude '**/evals/**' && npm run build -w @daveio/web",
    "drift": "node scripts/deps.mjs && npm run drift -w @daveio/mock-aws",
    "setup": "node scripts/deps.mjs && tsx apps/api/src/cli/setup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.45.4",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
