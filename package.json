{
  "name": "daveio-assignment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "seed": "npm run seed -w @daveio/mock-aws",
    "scan": "npm run scan -w @daveio/api",
    "dev:api": "npm run dev -w @daveio/api",
    "dev:web": "npm run dev -w @daveio/web",
    "evals": "npm run evals -w @daveio/api",
    "verify": "npm run typecheck && npm run lint && vitest run --exclude '**/evals/**' && npm run build -w @daveio/web",
    "drift": "npm run drift -w @daveio/mock-aws",
    "setup": "tsx apps/api/src/cli/setup.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
