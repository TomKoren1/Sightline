{
  "name": "sightline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "node scripts/deps.mjs && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "test": "node scripts/deps.mjs && vitest run",
    "test:watch": "node scripts/deps.mjs && vitest",
    "lint": "node scripts/deps.mjs && prettier --check . && eslint .",
    "format": "node scripts/deps.mjs && prettier --write . && eslint --fix .",
    "seed": "node scripts/deps.mjs && npm run seed -w @sightline/mock-aws",
    "scan": "node scripts/deps.mjs && npm run scan -w @sightline/api",
    "dev:api": "node scripts/deps.mjs && npm run dev -w @sightline/api",
    "dev:web": "node scripts/deps.mjs && npm run dev -w @sightline/web",
    "evals": "node scripts/deps.mjs && npm run evals -w @sightline/api",
    "verify": "node scripts/deps.mjs && npm run typecheck && npm run lint && vitest run --exclude '**/evals/groundTruth.test.ts' && npm run build -w @sightline/web",
    "drift": "node scripts/deps.mjs && npm run drift -w @sightline/mock-aws",
    "setup": "node scripts/deps.mjs && tsx apps/api/src/cli/setup.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
